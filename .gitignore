.DS_Store

# XcodeGen output — regenerated from project.yml, never committed.
*.xcodeproj

# Xcode user and build output
DerivedData/
build/
dist/
*.xcarchive
*.dSYM
*.xcuserstate
*.profraw
xcuserdata/

# Swift Package Manager local output
.build/
.swiftpm/

# Per-developer signing configuration
Configuration/Local.xcconfig

# mise-loaded release secrets and local overrides
/.env
/mise.local.toml

# Python verification caches
__pycache__/
build-dev/
